NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ADMIN_TOKEN=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Admin connection used ONLY by npm run db:init; leave blank once initialized.
POSTGRES_ADMIN_URL=
DATABASE_URL=postgresql://shorts:shorts@localhost:5432/shorts
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=ai-tech-shorts
APP_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_JOB_CRON=0 30 7 * * *
SCHEDULE_ENABLED=false
AUTO_PUBLISH=false
STORAGE_ROOT=./storage
MOCK_OPENAI=true
MOCK_YOUTUBE=true
MOCK_TELEGRAM=true
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Default 48h; optionally increase to 168h for a dated weekly test roundup.
MAX_NEWS_AGE_HOURS=48
# Conservative per-call USD reservations, set to cover the chosen models/tools.
MAX_RUN_COST_USD=5
TEXT_CALL_RESERVE_USD=0.10
SEARCH_CALL_RESERVE_USD=0.50
IMAGE_CALL_RESERVE_USD=0.25
VOICE_CALL_RESERVE_USD=0.25
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
FFMPEG_PATH=
FFPROBE_PATH=
CHANNEL_NAME=AI Tech Daily
# Optional licensed/owned music, mixed quietly beneath narration.
BACKGROUND_MUSIC_PATH=
RENDER_CONCURRENCY=1
ASSET_CONCURRENCY=2
